# Generated reports and prediction archives outside the standard output dirs
*_predictions.json
*_inference.json
*_summary.json
*_manifest.json
*.manifest.json
threshold_*.csv
*_report.json
*_report.csv
*.log

# C++ third-party source/install bundles are local deployment assets.
# Their per-directory .gitignore keeps the complete bundle untracked while
# preserving SOURCE_MANIFEST.md when present.
cpp/3rdparty/*
!cpp/3rdparty/.gitignore
!cpp/3rdparty/*/SOURCE_MANIFEST.md

